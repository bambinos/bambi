# Color-blind friendly cycle adapted from ArviZ.
axes.prop_cycle: cycler('color', ['36acc6', 'f66d7f', 'fac364', '7c2695', '228306', 'a252f4', '63f0ea', 'a77e4f'])

# Use an aspect ratio of 3:2 for all plots.
figure.figsize: 6, 4
figure.constrained_layout.use: True

# Keep only the left and bottom axes spines.
axes.spines.left: True
axes.spines.bottom: True
axes.spines.right: False
axes.spines.top: False

# Match the visible axes with their ticks.
xtick.top: False
xtick.bottom: True
xtick.direction: out
ytick.left: True
ytick.right: False
ytick.direction: out
